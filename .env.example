# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Required secrets ---
# Shared secret used to verify GitHub's X-Hub-Signature-256 webhook signature.
GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret
# Master key used to encrypt stored Discord webhook URLs. Use 32+ random bytes.
MASTER_KEY=change-me-master-key-32-random-bytes

# GitHub App credentials used by the worker.
GITHUB_APP_ID=123456
# Slug from https://github.com/settings/apps, used for the dashboard install link.
GITHUB_APP_SLUG=your-github-app-slug
# PEM can be supplied with literal \n characters in one environment variable.
GITHUB_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Model provider.
OPENAI_API_KEY=change-me-openai-key

# GitHub OAuth App credentials used by the dashboard.
GITHUB_CLIENT_ID=change-me-client-id
GITHUB_CLIENT_SECRET=change-me-client-secret
SESSION_SECRET=change-me-separate-session-signing-key
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Optional ---
# DATABASE_URL=sqlite:///./auto_review.db
# PostgreSQL example: postgresql+psycopg://review:password@db:5432/review
# APP_DEBUG=false
# GITHUB_API_URL=https://api.github.com
# Publish review summaries and inline annotations as GitHub Checks. Requires Checks: write.
# GITHUB_CHECKS_ENABLED=false
# OPENAI_BASE_URL=https://api.openai.com/v1
# Use chat_completions for providers that do not implement the Responses API.
# OPENAI_API_STYLE=responses
# Chat compatibility fallbacks: json_schema (strict), json_object, or prompt (no format field).
# OPENAI_CHAT_RESPONSE_FORMAT=json_schema
# Legacy compatible APIs may require max_tokens instead of max_completion_tokens.
# OPENAI_CHAT_TOKEN_LIMIT_FIELD=max_completion_tokens
# WORKER_POLL_SECONDS=2
# WORKER_LEASE_SECONDS=300
# WORKER_MAX_ATTEMPTS=3
# Worker metrics bind to loopback by default. Use 0.0.0.0 only on a trusted container network.
# WORKER_METRICS_HOST=127.0.0.1
# WORKER_METRICS_PORT=9100
